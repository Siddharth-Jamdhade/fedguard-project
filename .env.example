# =============================================
# FedGuard PS-13 — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# The .env file is NEVER committed to git

# Electricity tariff (₹ per kWh) — change for your state/DISCOM
TARIFF_INR_PER_KWH=8.0

# CEA Grid Emission Factor (kg CO2 per kWh) — India 2023
EMISSION_FACTOR_KG_CO2_PER_KWH=0.82

# COM port for live ESP32 serial data capture
# Windows: COM3, COM4 etc. | Linux/Mac: /dev/ttyUSB0
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Streamlit dashboard port (optional)
STREAMLIT_PORT=8501
