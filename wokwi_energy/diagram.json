{
  "version": 1,
  "author": "FedGuard PS-13",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 100,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-mpu6050",
      "id": "imu1",
      "top": 20,
      "left": 330,
      "attrs": { "i2c-address": "0x68" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 220,
      "left": 330,
      "attrs": { "label": "Power Load (0-2500W)" }
    },
    {
      "type": "wokwi-a4988",
      "id": "drv1",
      "top": 40,
      "left": -220,
      "attrs": {}
    },
    {
      "type": "wokwi-stepper-motor",
      "id": "motor1",
      "top": -180,
      "left": -220,
      "attrs": { "size": "17" }
    }
  ],
  "connections": [
    ["esp:TX",     "$serialMonitor:RX", "", []],
    ["esp:RX",     "$serialMonitor:TX", "", []],

    ["esp:GPIO21", "imu1:SDA",  "blue",   []],
    ["esp:GPIO22", "imu1:SCL",  "green",  []],
    ["esp:3V3",    "imu1:VCC",  "red",    []],
    ["esp:GND.1",  "imu1:GND",  "black",  []],

    ["esp:3V3",    "pot1:VCC",  "red",    []],
    ["esp:GND.2",  "pot1:GND",  "black",  []],
    ["esp:GPIO34", "pot1:SIG",  "yellow", []],

    ["esp:GPIO16", "drv1:STEP", "purple", []],
    ["esp:GPIO17", "drv1:DIR",  "purple", []],
    ["esp:3V3",    "drv1:VDD",  "red",    []],
    ["esp:GND.2",  "drv1:GND.2","black",  []],
    ["esp:GND.3",  "drv1:ENABLE","black", []],
    ["drv1:RESET", "drv1:SLEEP","green",  []],

    ["drv1:1A",    "motor1:B+", "green",  []],
    ["drv1:1B",    "motor1:B-", "green",  []],
    ["drv1:2A",    "motor1:A+", "green",  []],
    ["drv1:2B",    "motor1:A-", "green",  []]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
